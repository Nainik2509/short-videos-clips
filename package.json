{
  "name": "animated-story-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical (1080x1920, 30fps) animated story studio built on Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "new-story": "python3 tools/story/new_story.py",
    "timings": "\"$HOME/.venvs/whisper/bin/python\" tools/story/timings.py",
    "storyboard": "node tools/story/storyboard.mjs",
    "finish": "node tools/story/finish.mjs",
    "youtube": "node tools/publish/youtube-pack.mjs",
    "edit": "node tools/footage/edit.mjs",
    "refs": "node tools/footage/refs.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && for f in tools/*/*.mjs; do node --check \"$f\" || exit 1; done && python3 -m py_compile tools/story/new_story.py tools/story/timings.py",
    "brand": "node tools/publish/brand.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
    "@remotion/renderer": "4.0.543",
    "@remotion/three": "4.0.543",
    "postprocessing": "6.39.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/three": "0.187.0",
    "hyperframes": "^0.9.56",
    "typescript": "^5.6.0"
  }
}
